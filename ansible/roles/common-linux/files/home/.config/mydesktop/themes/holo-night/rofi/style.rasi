/**
 * Holo Night theme for Rofi
*/

* {
    padding: 0;
    margin: 0;
    border: 0;
    spacing: 0;
    vertical-align: 0.5;

    font: "Liberation Sans 11";
    border-radius: 0;
    border: 0;
    text-color: #eff1f5;
    background-color: transparent;
}

configuration {
    /* display-drun: " Applications : ";
    display-run: " Commands: ";
    display-window: " Windows : "; */
}

window {
    width: 25%;
    height: 50%;
    location: center;

    border: 1px;
    border-radius: 8px;
    border-color: rgba(255, 255, 255, 0.3);
    background-color: rgba(43, 48, 59, 0.7);
}

mainbox {
    padding: 6px;
    margin: 8px;
    border: 0;
    children: [inputbar, message, listview];
}

inputbar {
    margin: 2px 2px 12px 2px;
    border: 0;
    children: [entry];
}

prompt {
    padding: 5px;
    margin: 2px;
    border: 0;
    background-color: transparent;
    text-color: black;
}

entry {
    padding: 5px;
    margin: 2px;
    border: 1px;
    border-radius: 6px;
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(255, 255, 255, 0.1);
    cursor-width: 1px;
    cursor: text;
}

listview {
    lines: 8;
    padding: 4px;
    margin: 0;
    children: [element];
}

element {
    padding: 2px;
    background-color: transparent;
}

element-text {
    size: 1em;
    padding: 0 4px;
    margin: 0px;
    text-color: inherit;
}

element-icon {
    padding: 2px 6px;
    margin: 0;
    size: 2em;
}

element selected {
    background-color: rgba(255, 128, 236, 0.4);
    border-radius: 6px;
    border: 1px;
    border-color: rgba(255, 255, 255, 0.612);
    text-color: inherit;
}

element selected active {
}

message {
    expand: true;
    children: [textbox];
}

textbox {
    expand: true;
    margin: 6px;
    padding: 3px;
    text-color: inherit;
}

error-message {
    expand: true;
    border: 1px;
    background-color: rgb(58, 38, 41);
    text-color: inherit;
}
